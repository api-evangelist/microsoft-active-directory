{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Active Directory (via Microsoft Graph) Applications Directory Roles API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Directory Roles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List activated directory roles in the tenant",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://graph.microsoft.com/v1.0/directoryRoles"
          },
          "docs": "List activated directory roles in the tenant"
        },
        {
          "info": {
            "name": "List members of a directory role",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://graph.microsoft.com/v1.0/directoryRoles/:id/members",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List members of a directory role"
        }
      ]
    }
  ],
  "bundled": true
}